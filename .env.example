# Copia in .env.local e compila con i valori del progetto Supabase
# (Supabase → Project Settings → API). La chiave "anon" è pubblica per natura:
# la sicurezza la fanno le regole RLS nel database.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Dominio tecnico delle email di login (nome.cognome@DOMINIO)
VITE_LOGIN_DOMAIN=utenti.filodape.it
